# ==============================================================================
# CheckAI API — Variáveis de Ambiente (exemplo)
# ==============================================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env com credenciais reais.
# ==============================================================================

# Ambiente: "development" (loga link de recuperação) ou "production"
ENVIRONMENT=development

# Servidor
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# JWT
JWT_SECRET_KEY=troque_por_uma_chave_secreta_segura_aqui
JWT_ALGORITHM=HS256
JWT_EXPIRACAO_MINUTOS=60

# Banco de dados MySQL
DATABASE_URL=mysql+pymysql://root:senha@localhost:3306/checkai

# Serviços externos
SERPER_API_KEY=sua_chave_serper_aqui
GOOGLE_FACTCHECK_API_KEY=sua_chave_google_factcheck_aqui

# E-mail (SMTP) — deixe SMTP_HOST vazio para usar modo dev (loga o link)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@checkai.com.br


# URL do frontend (usada nos links de e-mail)
FRONTEND_URL=http://localhost:5173

# Expiração do token de recuperação de senha (minutos)
RESET_TOKEN_EXPIRACAO_MINUTOS=60

# Extração de artigos (0 = apenas snippets, mais rápido)
EXTRAIR_ARTIGOS_MAX=0
