# Variáveis de ambiente para o Docker Compose
# Copie este arquivo para .env e preencha os valores.

# Configuração do Banco de Dados MySQL
MYSQL_DATABASE=checkai
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306

# Configuração da API
API_PORT=8000
API_DEBUG=true

# Segredos da Aplicação (JWT)
# Gere uma chave forte com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRACAO_MINUTOS=60

# Serper.dev — Busca Web em Tempo Real (https://serper.dev)
# 2500 buscas/mês grátis. Obtenha a chave em: https://serper.dev/api-key
SERPER_API_KEY=