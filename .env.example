# ==============================================================================
# CheckAI — Variáveis de Ambiente (exemplo)
# ==============================================================================
# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA commite o arquivo ".env" no repositório.
# ==============================================================================

# Chave da API do Google Fact Check Tools
GOOGLE_FACTCHECK_API_KEY=COLE_SUA_CHAVE_AQUI

# Configurações do servidor da API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true