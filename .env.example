# ==============================================================================
# CheckAI — Variáveis de Ambiente (exemplo)
# ==============================================================================
# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA commite o arquivo ".env" no repositório.
# ==============================================================================

# Chave da API do Google Fact Check Tools
GOOGLE_FACTCHECK_API_KEY=COLE_SUA_CHAVE_AQUI

# Configurações do servidor da API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Altere o SUA_SENHA pela senha do MySQL
DATABASE_URL=mysql+pymysql://root:SUA_SENHA@localhost:3306/checkai

# Login com Jason Web Token (senha encriptografada)
JWT_SECRET_KEY=sua_chave_secreta_aqui
JWT_ALGORITHM=HS256
JWT_EXPIRACAO_MINUTOS=60