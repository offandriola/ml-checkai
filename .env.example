# Variáveis de ambiente para o Docker Compose
# Copie este arquivo para .env e preencha os valores.

# Configuração do Banco de Dados MySQL
MYSQL_DATABASE=checkai
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306

# Configuração da API
API_PORT=8000
API_DEBUG=true

# Segredos da Aplicação (JWT)
# Gere uma chave forte com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRACAO_MINUTOS=60

# API Key para o Serper (busca web)
# Obtenha sua API key em: https://serper.dev/
SERPER_API_KEY=<api_key_do_serper>